{
  "name": "ai-english-course-platform",
  "version": "0.6.0",
  "description": "Interactive Web Creation & AI Literacy Platform for Kids (English + AI Course, Lessons 2-5)",
  "main": "platform/server.js",
  "scripts": {
    "start": "node platform/server.js",
    "dev": "node --watch platform/server.js",
    "test": "node --test tests/*.test.js",
    "check": "node tools/check.js",
    "smoke": "node tools/smoke.js",
    "seed": "node tools/seed.js",
    "build": "node tools/site-builder.js --config demo-export.json",
    "backup": "node tools/backup.js backup",
    "restore": "node tools/backup.js restore"
  },
  "engines": {
    "node": ">=24 <27"
  },
  "keywords": [
    "edtech",
    "english",
    "ai-literacy",
    "clil",
    "pbl",
    "vietnam"
  ],
  "author": "Sergey",
  "license": "UNLICENSED",
  "private": true,
  "dependencies": {
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "prettier": "3.9.10"
  }
}
