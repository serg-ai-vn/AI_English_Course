# --- Server Configuration ---
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Security & Teacher Access ---
# Default teacher PIN for DEMO class (override in production)
TEACHER_PIN_DEMO=0000
SESSION_TTL_HOURS=24

# --- AI Provider Configuration (Task 03) ---
# Mode: "mock" (offline deterministic simulator) or "openai" (live API)
AI_PROVIDER=mock

# OpenAI API Settings (used when AI_PROVIDER=openai)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
OPENAI_TEXT_MODEL=gpt-4o-mini
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_TIMEOUT_MS=25000

# Smart AI Tutor Hinting on Gate Errors ("true" or "false")
AI_TUTOR_HINTS_ENABLED=true

# --- Future Database Migration (Task 05 - Optional) ---
# STORAGE_DRIVER=json
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
