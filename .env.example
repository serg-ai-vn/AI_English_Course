# Copy to .env. Demo starts locally without API access. Never commit .env.
APP_MODE=demo
HOST=127.0.0.1
PORT=3000
# DATA_DIR defaults to platform/data. Set an absolute directory for pilot.
SESSION_TTL_HOURS=24
ALLOW_RESET=false
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_TIMEOUT_MS=90000
# Hard limits reserve provider requests including failed requests, not dollar estimates.
AI_IMAGE_REQUEST_LIMIT=100
AI_TEXT_REQUEST_LIMIT=300
# Set TEACHER_PIN_CLASSCODE for each pilot class; DEMO is forbidden in pilot.
